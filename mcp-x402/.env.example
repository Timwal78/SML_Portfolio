# === TRANSPORT ===
# stdio (default, for Claude Code) or sse (remote/Cursor)
MCP_TRANSPORT=stdio
MCP_SSE_PORT=3402

# === SML API ===
# Base URL for ScriptMasterLabs APIs
SML_API_BASE=https://api.scriptmasterlabs.com
SML_MTLS_CERT_PATH=./certs/client.crt
SML_MTLS_KEY_PATH=./certs/client.key
SML_MTLS_CA_PATH=./certs/sml-ca.crt

# === WALLET (stored in OS keychain — env only for CI/testnet) ===
# NEVER use in production — use OS keychain instead
# CI_WALLET_SEED=your-bip39-mnemonic-here

# === CHAINS ===
# Base mainnet only (operator directive, 2026-08-01) — this gateway settles
# real customer USDC and must never route to a testnet under any
# configuration, so the prior TESTNET/BASE_SEPOLIA_RPC_URL toggle was
# removed entirely rather than left as an accidental-misconfiguration risk.
BASE_RPC_URL=https://mainnet.base.org
XRPL_RPC_URL=wss://xrplcluster.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# === SPEND LIMITS ===
DAILY_SPEND_CAP_USD=50
AUTO_APPROVE_THRESHOLD_USD=1
PRICE_CACHE_TTL_MS=60000

# === AUDIT ===
AUDIT_LOG_PATH=./audit.log

# === CREDIT BUREAU ===
MIN_CREDIT_SCORE=300

# === EQUITIES / OPTIONS HEATMAP (self-contained: no upstream proxy) ===
# Required for equities_heatmap_full / options_delta_heatmap_full — missing
# either causes those two tools to fail with a clear "not_configured" error.
POLYGON_API_KEY=
ANTHROPIC_API_KEY=
# Optional — defaults to claude-sonnet-4-5
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional — posts a Discord embed on every paid equities_heatmap_full /
# options_delta_heatmap_full call (top overbought/oversold + swarm synthesis
# excerpt). Leave unset to disable; failures are logged, never fatal.
DISCORD_WEBHOOK_URL=

# === HOUSING / SECTION 8 — NATIONWIDE HUD DATA ===
# Required for section8_fmr_national / section8_income_limits / section8_geo_lookup.
# Free registration: https://www.huduser.gov/hudapi/public/register
# Missing this causes those three tools to fail with a clear "not configured"
# error — they never fall back to the curated Lenoir County, NC seed data
# used by pha_lookup / hcv_fmr / housing_landlord_checklist / hud_vash_contacts.
HUD_USER_TOKEN=

# Also required already by federal_sam_opportunities / federal_sam_entity
# (undocumented here previously — pre-existing gap, not introduced by the
# housing tools above). Free registration: https://sam.gov/data-services
SAM_API_KEY=

# Optional — only set once a SECOND, separate AWS Marketplace listing for the
# Section 8/HUD tools exists (Partner Central assigns this after you create
# that product). Leave unset until then: the existing federal/medical/finance
# listing (prod-lop2m2yjjcs76) keeps working unaffected either way. Once set,
# customers entitled to THIS product code get free bypass only on the
# /x402/pha-lookup, /x402/hcv-fmr, /x402/hud-vash-contacts,
# /x402/housing-landlord-checklist, /x402/housing-windsor,
# /x402/section8-geo-lookup, /x402/section8-fmr, /x402/section8-income-limits,
# /x402/pha-opportunities, and /x402/pha-search routes — never the full catalog.
AWS_MARKETPLACE_HOUSING_PRODUCT_CODE=

# Optional — only meaningful once AWS_MARKETPLACE_HOUSING_PRODUCT_CODE above
# is set AND the housing listing's SaaS Contract product has multiple
# dimensions configured in AWS Partner Central (one per tier: Contractor/
# Professional/Authority-Enterprise/Government — see docs/SECTION8_HUD_LISTING.md).
# JSON object mapping AWS's real dimension ID (YOU choose these when creating
# the product — this repo cannot know them in advance) to this codebase's
# internal tier key. Example:
#   {"contractor-calls":"contractor","professional-calls":"professional","authority-calls":"authority_enterprise","government-calls":"government"}
# Leave unset (or leave a dimension unmapped) and that customer's usage is
# never capped — same unconditional-bypass behavior as today. See
# src/server/aws/tiers.ts's TIER_MONTHLY_CALL_CAP for the actual per-tier caps.
AWS_MARKETPLACE_TIER_DIMENSIONS_JSON=

# Real earnings data source for xdeo_earnings_estimate (fixed 2026-08-01 —
# previously called a dead host with no real backend anywhere). Free tier:
# https://www.alphavantage.co/support/#api-key. Without this set, the tool
# honestly reports { status: "unavailable" } and never charges — it does
# not fabricate a figure. Only covers EPS (estimated/reported/surprise) for
# quarters that have already reported; revenue and guidance always abstain
# regardless of this key, since no free source exists for either.
ALPHA_VANTAGE_API_KEY=

# Real contact string used as part of the User-Agent header when
# xmit_edgar_decode fetches a filing directly from SEC EDGAR (fixed
# 2026-08-01 — previously called a dead host with no real backend
# anywhere). SEC's fair-access policy requires a descriptive User-Agent
# identifying the requester + a real contact:
# https://www.sec.gov/os/webmaster-faq#developers. Example:
#   ScriptMasterLabs mcp-x402 admin@scriptmasterlabs.com
SEC_EDGAR_CONTACT=

# Durable x402 payment-activity counters (fixed 2026-08-01). Without this,
# GET /x402/stats's aiAgentsAllTime and settledByFacilitator counts persist
# only to /tmp/x402-stats.json, which does NOT survive a Render redeploy —
# a fresh container gets a fresh /tmp, so "how many real payments has this
# ever settled" was silently resetting to zero on every deploy. Set this to
# make those counts actually durable across deploys.
REDIS_URL=
