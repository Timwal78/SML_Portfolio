    {
      "name": "Federal Contract Opportunities Feed API",
      "request": {
        "method": "GET",
        "description": "Real-time feed of federal contract opportunities. Search by NAICS code, agency, state, or keyword. Includes solicitation type, response deadline, award value, and contracting office details.\n\nParameters:\n- naics (string): NAICS industry code filter\n- agency (string): Contracting agency name\n- state (string): 2-letter state code\n- keyword (string): Search keyword\n- limit (integer): Max results (default 50)",
        "url": {
          "raw": "https://mcp-x402.onrender.com/v1/federal-contract-opportunities-feed-api",
          "host": [
            "mcp-x402",
            "onrender",
            "com"
          ],
          "path": [
            "v1",
            "federal-contract-opportunities-feed-api"
          ],
          "query": [
            {
              "key": "naics",
              "value": "",
              "description": "NAICS industry code filter"
            },
            {
              "key": "agency",
              "value": "",
              "description": "Contracting agency name"
            },
            {
              "key": "state",
              "value": "",
              "description": "2-letter state code"
            },
            {
              "key": "keyword",
              "value": "",
              "description": "Search keyword"
            },
            {
              "key": "limit",
              "value": "",
              "description": "Max results (default 50)"
            }
          ]
        },
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{API_KEY}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ]
      }
    },
